diff -urN a/board/sunplus/pentagram_board/tpsleds.c a/board/sunplus/pentagram_board/tpsleds.c
--- a/board/sunplus/pentagram_board/tpsleds.c	1970-01-01 03:00:00.000000000 +0300
+++ a/board/sunplus/pentagram_board/tpsleds.c	2026-03-12 13:47:16.103615819 +0300
@@ -0,0 +1,83 @@
+ /*
